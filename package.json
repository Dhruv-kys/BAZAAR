{
  "name": "bazaar",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm run test -w server",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc -b web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "better-sqlite3@13.0.3": true
  }
}
